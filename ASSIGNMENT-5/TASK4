#include <iostream>
#include <stdexcept>
#include <string>
using namespace std;

// Base exception class
class BillingError : public runtime_error {
public:
    using runtime_error::runtime_error;
};

// Derived exception classes
class ClaimError : public BillingError {
public:
    using BillingError::BillingError;
};

class InvalidBillError : public BillingError {
public:
    using BillingError::BillingError;
};

class PackageError : public BillingError {
public:
    using BillingError::BillingError;
};

class PatientNotFoundError : public BillingError {
public:
    using BillingError::BillingError;
};

// Check bill amount
void validateCharge(double amount) {
    if (amount < 0)
        throw InvalidBillError("Negative charges");
}

// Check insurance claim
void checkClaim(double billed, double cover) {
    if (billed > cover)
        throw ClaimError("Claim exceeds cover");
}

// Check package
void checkPackage(string package) {
    if (package != "IP" && package != "OP")
        throw PackageError("Unknown package");
}

// Check patient record
void findPatient(bool found) {
    if (!found)
        throw PatientNotFoundError("Patient record missing");
}

// Destructor should not throw
class Bill {
public:
    ~Bill() noexcept {
        cout << "Bill object destroyed" << endl;
    }
};

int main() {
    try {
        validateCharge(5000);
        cout << "Valid bill amount" << endl;

        checkClaim(60000, 50000);
        cout << "Claim approved" << endl;
    }
    catch (const ClaimError& e) {
        cout << "Claim Error: " << e.what() << endl;
    }

    try {
        validateCharge(-100);
    }
    catch (const BillingError& e) {
        cout << "Billing Error: " << e.what() << endl;
    }

    try {
        checkPackage("XYZ");
    }
    catch (const BillingError& e) {
        cout << "Package Error: " << e.what() << endl;
    }

    try {
        findPatient(false);
    }
    catch (const BillingError& e) {
        cout << "Patient Error: " << e.what() << endl;
    }

    try {
        Bill b;
        // Memory allocation failure can be caught here.
        // For example, a failed new allocation throws bad_alloc.
    }
    catch (const bad_alloc& e) {
        cout << "Memory allocation failed" << endl;
    }

    return 0;
}
