#include <iostream>
using namespace std;

// Error status values
enum Status {
    SUCCESS,
    NEGATIVE_AMOUNT,
    CLAIM_EXCEEDS_COVER,
    UNKNOWN_PACKAGE,
    PATIENT_NOT_FOUND
};

// Function to check billing errors
Status checkBilling(double amount, double cover,
                    int packageValid, int patientFound) {

    if (amount < 0)
        return NEGATIVE_AMOUNT;

    if (amount > cover)
        return CLAIM_EXCEEDS_COVER;

    if (!packageValid)
        return UNKNOWN_PACKAGE;

    if (!patientFound)
        return PATIENT_NOT_FOUND;

    return SUCCESS;
}

// Display result
void display(Status result) {
    switch (result) {
        case SUCCESS:
            cout << "Bill approved" << endl;
            break;

        case NEGATIVE_AMOUNT:
            cout << "Error: Negative amount" << endl;
            break;

        case CLAIM_EXCEEDS_COVER:
            cout << "Error: Claim exceeds cover" << endl;
            break;

        case UNKNOWN_PACKAGE:
            cout << "Error: Unknown package" << endl;
            break;

        case PATIENT_NOT_FOUND:
            cout << "Error: Patient record missing" << endl;
            break;
    }
}

int main() {
    display(checkBilling(40000, 50000, 1, 1));

    display(checkBilling(-100, 50000, 1, 1));

    display(checkBilling(60000, 50000, 1, 1));

    display(checkBilling(30000, 50000, 0, 1));

    display(checkBilling(30000, 50000, 1, 0));

    return 0;
}
